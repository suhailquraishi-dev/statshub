# Copy to .env.local (git-ignored) for local development. Never commit real values.
# Stats source: "es" uses the ES Stats API; anything else (or unset) uses the demo provider.
STATS_PROVIDER=es
STATS_API_BASE_URL=https://es-stats.duckdns.org
# Bearer token from https://es-stats.duckdns.org/portal
STATS_API_KEY=
# Signs the sign-in cookie. Long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Public site address, used for share links.
SITE_URL=http://localhost:3000
